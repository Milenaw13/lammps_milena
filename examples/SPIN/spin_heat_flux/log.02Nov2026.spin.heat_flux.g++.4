# equilibrium run without thermostat for the Green-Kubo integral
# kappa = V/(kB T^2) * integral <q(t) q(0)> dt, with q = Q/(ly*lz)
# conversion from eV/(ps A K) to W/(m K): 1602.176634

unfix           1
reset_timestep  0

compute         qs all spin/heat/flux right left
variable        qx equal c_qs/(ly*lz)
fix             QQ all ave/correlate $s $p $d v_qx type auto file Qspin.acf ave running
fix             QQ all ave/correlate 5 $p $d v_qx type auto file Qspin.acf ave running
fix             QQ all ave/correlate 5 200 $d v_qx type auto file Qspin.acf ave running
fix             QQ all ave/correlate 5 200 1000 v_qx type auto file Qspin.acf ave running

variable        kB equal 8.617333262e-5
variable        scale equal 1602.176634*vol/(${kB}*$t*$t)*$s*dt
variable        scale equal 1602.176634*vol/(8.617333262e-05*$t*$t)*$s*dt
variable        scale equal 1602.176634*vol/(8.617333262e-05*300*$t)*$s*dt
variable        scale equal 1602.176634*vol/(8.617333262e-05*300*300)*$s*dt
variable        scale equal 1602.176634*vol/(8.617333262e-05*300*300)*5*dt
variable        kx equal trap(f_QQ[3])*v_scale

# all auto- and cross-correlations of the 3 channels c_qs[1..3] for
# gk_spin_channels.py (channel shares of kappa)
fix             QC all ave/correlate $s $p $d c_qs[1] c_qs[2] c_qs[3]                 type full file Qspin_channels.acf ave running
fix             QC all ave/correlate 5 $p $d c_qs[1] c_qs[2] c_qs[3]                 type full file Qspin_channels.acf ave running
fix             QC all ave/correlate 5 200 $d c_qs[1] c_qs[2] c_qs[3]                 type full file Qspin_channels.acf ave running
fix             QC all ave/correlate 5 200 1000 c_qs[1] c_qs[2] c_qs[3]                 type full file Qspin_channels.acf ave running

thermo_style    custom step temp v_tmag etotal c_qs v_qx v_kx
thermo_modify   format float %15.8g
thermo          $d
thermo          1000
run             4000
