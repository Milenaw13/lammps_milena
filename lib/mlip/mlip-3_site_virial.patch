+                    site_virial[j][4] -= dx * gz;   // xz
+                    site_virial[j][5] -= dy * gz;   // yz
+                    site_virial[j][6] -= dy * gx;   // yx
+                    site_virial[j][7] -= dz * gx;   // zx
+                    site_virial[j][8] -= dz * gy;   // zy
+                }
+            }
