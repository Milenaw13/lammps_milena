# magnon heat flow in bcc iron with compute spin/heat/flux and a
# Green-Kubo estimate of the magnon thermal conductivity along x
# (method of Zhou et al., Phys. Rev. B 101, 224303 (2020)), split into
# exchange channels (pairs of atom types).  The two sites of the bcc cell
# are given different atom types (1 = corner, 2 = body center) with the
# same interactions, so the channels are 1-1, 1-2 and 2-2.
# The runs are far too short for a converged value; this input only
# shows how the commands are used.

variable        t equal 300.0      # temperature (K)
variable        p equal 200        # correlation length (samples)
variable        s equal 5          # sample interval (steps)
variable        d equal $p*$s      # output interval (steps)
variable        d equal 200*$s      
variable        d equal 200*5      

units           metal
atom_style      spin
dimension       3
boundary        p p p

# necessary for the serial algorithm (sametag)
atom_modify     map array

lattice         bcc 2.8665
Lattice spacing in x,y,z = 2.8665 2.8665 2.8665
region          box block 0.0 8.0 0.0 8.0 0.0 8.0
create_box      2 box
Created orthogonal box = (0 0 0) to (22.932 22.932 22.932)
  1 by 2 by 2 MPI processor grid
create_atoms    1 box basis 2 2
Created 1024 atoms
  using lattice units in orthogonal box = (0 0 0) to (22.932 22.932 22.932)
  create_atoms CPU = 0.001 seconds

mass            * 55.845
set             group all spin/atom 2.2 0.0 0.0 1.0
Setting atom values ...
  1024 settings made for spin/atom
velocity        all create $(2.0*v_t) 4928459 rot yes dist gaussian loop geom
velocity        all create 600 4928459 rot yes dist gaussian loop geom

pair_style      hybrid/overlay eam/alloy spin/exchange 3.5
pair_coeff      * * eam/alloy ../iron/Fe_Mishin2006.eam.alloy Fe Fe
pair_coeff      * * spin/exchange exchange 3.4 0.02726 0.2171 1.841

neighbor        0.1 bin
neigh_modify    every 10 check yes delay 20

# two halves along x; with periodic boundaries they share two
# interfaces normal to x, each of area ly*lz

region          left block INF 4.0 INF INF INF INF
group           left region left
576 atoms in group left
group           right subtract all left
448 atoms in group right

timestep        0.0001

compute         out_mag all spin
variable        tmag equal c_out_mag[6]

# heat the spins with a thermostat, the lattice equilibrates from 2t
# (zero field; fix langevin/spin must come after fix precession/spin)

fix             0 all precession/spin zeeman 0.0 0.0 0.0 1.0
fix             1 all langevin/spin $t 0.1 21
fix             1 all langevin/spin 300 0.1 21
fix             2 all nve/spin lattice moving
thermo_style    custom step temp v_tmag pe etotal
thermo          100
run             1000

