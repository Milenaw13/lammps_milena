+        // 9 components in LAMMPS order xx yy zz xy xz yz yx zx zy.
+        // Ghost entries are summed into their owners by the reverse
+        // communication of compute centroid/stress/atom (newton on).
+        // site_virial must have 9 columns and nlocal+nghost rows.
+        if (site_virial != nullptr)
+        {
